[Unit]
Description=Chess App
After=network.target

[Service]
Type=simple
User=chess
WorkingDirectory=/opt/chess
EnvironmentFile=/opt/chess/.env
# Debian/Ubuntu install the stockfish binary at /usr/games/stockfish, which is
# not on systemd's default PATH. Set the explicit path so the engine pool can
# spawn it without depending on $PATH.
Environment=CHESSLEAP_STOCKFISH_PATH=/usr/games/stockfish
ExecStart=/opt/chess/chess-server
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/chess
PrivateTmp=true

[Install]
WantedBy=multi-user.target
