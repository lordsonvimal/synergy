{
  "name": "chessleap",
  "private": true,
  "version": "1.0.0",
  "description": "ChessLeap — learn, play, and improve chess skills with live classes",
  "keywords": [
    "chess",
    "game",
    "multiplayer",
    "golang"
  ],
  "repository": {
    "type": "git",
    "url": "github.com/lordsonvimal/synergy/apps/chess"
  },
  "license": "ISC",
  "author": "lordson vimal",
  "type": "module",
  "scripts": {
    "dev": "make live",
    "build:css": "npx @tailwindcss/cli -i ./ui/styles/style.css -o ./dist/style.css --minify",
    "build:js": "node ./scripts/build-js.mjs",
    "build:assets": "node ./scripts/build-assets.mjs",
    "build": "rm -rf dist && yarn build:css && yarn build:js && yarn build:assets",
    "build:dev": "CHESS_BUILD_DEV=1 yarn build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "chessops": "^0.15.0",
    "esbuild": "^0.27.7"
  }
}
