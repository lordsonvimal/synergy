package components

import (
	"github.com/lordsonvimal/synergy/apps/chess/engine"
	"github.com/lordsonvimal/synergy/apps/chess/game"
)

templ RenderChessBoard(g *game.Game) {
	// data-signals.ifmissing ensures $flipped is only initialised once;
	// SSE board patches that morph this element will never reset it.
	<div id="chessboard" data-testid="chessboard" data-signals.ifmissing='{"flipped":false}'>
		<div class="w-full aspect-square">
			<div
				class="grid grid-cols-8 grid-rows-8 w-full h-full"
				data-class="{'rotate-180': $flipped}"
			>
				for rank := 7; rank >= 0; rank-- {
					for file := 0; file < 8; file++ {
						@RenderChessSquare(g, rank, file)
					}
				}
			</div>
		</div>
	</div>
}

// RenderHistoryBoard renders a read-only snapshot of the board at a historical position.
// It is the SSE response target — DataStar morphs #history-board-content with this.
templ RenderHistoryBoard(board *engine.Board) {
	<div id="history-board-content" class="w-full h-full">
		<div
			class="grid grid-cols-8 grid-rows-8 w-full h-full"
			data-class="{'rotate-180': $flipped}"
		>
			for rank := 7; rank >= 0; rank-- {
				for file := 0; file < 8; file++ {
					@RenderReadOnlyChessSquare(board, rank, file)
				}
			}
		</div>
	</div>
}
