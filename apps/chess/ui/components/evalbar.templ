package components

// EvalBar renders a vertical Stockfish eval bar bound to DataStar signals
// (evalWp, evalDisplay, evalReady, evalAnalyzing). It sits flush against the
// left edge of the board and matches its height via self-stretch.
//
// The bar shows black's share on top and white's share on bottom; the
// boundary moves as evalWp updates. A label at the bottom shows the formatted
// score ("+0.42" / "M5"). Hidden until the first analysis update arrives.
templ EvalBar() {
	<div
		class="relative w-5 sm:w-7 self-stretch select-none overflow-hidden"
		style="background-color:#ffffff;color-scheme:light"
		data-class="{'rotate-180': $flipped}"
		title="Engine evaluation"
	>
		<div
			class="absolute top-0 left-0 right-0 transition-[height] duration-200 ease-out"
			style="background-color:#111111"
			data-style="{height: $evalBlackHeight}"
		></div>
		<span
			class="absolute inset-x-0 bottom-0.5 text-[7px] sm:text-[8px] font-mono text-center leading-none"
			data-style="{color: $evalTextColor}"
			data-class="{'rotate-180': $flipped}"
			data-text="$evalDisplay"
		></span>
	</div>
}
