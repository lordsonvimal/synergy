package components

templ ShareLinksPanel(gameID, whiteToken, blackToken, myRole string) {
	<div class="bg-surface-1 border border-edge rounded-md p-4 flex flex-col gap-3">
		<p class="text-sm font-medium text-ink">Share invite links with your opponent</p>
		<div class="flex flex-col gap-2">
			@shareLinkRow("White player link", "/play/"+gameID+"?token="+whiteToken, myRole == "white")
			@shareLinkRow("Black player link", "/play/"+gameID+"?token="+blackToken, myRole == "black")
		</div>
		<p class="text-xs text-ink-muted">The clock starts once both players have connected.</p>
	</div>
}

templ shareLinkRow(label, url string, isMyRole bool) {
	{{
		copyJS := "(() => {" +
			"const t = location.origin + '" + url + "';" +
			"const b = event.currentTarget;" +
			"const done = () => { const o = b.dataset.origLabel || b.textContent; b.dataset.origLabel = o; b.textContent = 'Copied'; setTimeout(() => { b.textContent = o; }, 1500); };" +
			"const fallback = () => {" +
			"  const ta = document.createElement('textarea');" +
			"  ta.value = t; ta.setAttribute('readonly', '');" +
			"  ta.style.position = 'fixed'; ta.style.top = '0'; ta.style.left = '0'; ta.style.opacity = '0';" +
			"  document.body.appendChild(ta); ta.focus(); ta.select();" +
			"  try { document.execCommand('copy'); done(); } catch (e) {}" +
			"  document.body.removeChild(ta);" +
			"};" +
			"if (navigator.clipboard && window.isSecureContext) {" +
			"  navigator.clipboard.writeText(t).then(done).catch(fallback);" +
			"} else { fallback(); }" +
			"})()"
	}}
	<div class="flex flex-col gap-2">
		<span class="text-xs text-ink-subtle">
			{ label }
			if isMyRole {
				<span class="ml-1 text-xs font-medium text-primary">(you)</span>
			}
		</span>
		<div class="flex gap-2 items-center">
			<input
				type="text"
				readonly
				value={ url }
				data-attr-value={ templ.JSExpression("location.origin + '" + url + "'") }
				class="flex-1 min-w-0 text-xs bg-surface-4 border border-edge rounded px-2 py-2 text-ink-subtle select-all"
			/>
			<button
				type="button"
				aria-label="Copy invite link"
				class="text-xs px-3 py-2 bg-primary text-on-primary border border-primary rounded cursor-pointer hover:bg-primary-hover hover:border-primary-hover active:bg-primary-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 transition touch-manipulation select-none"
				data-on:click={ templ.JSExpression(copyJS) }
			>
				Copy
			</button>
		</div>
	</div>
}
