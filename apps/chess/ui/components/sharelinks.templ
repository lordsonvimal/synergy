package components

// ShareLinksPanel is shown to the game creator while waiting for their opponent
// to claim the remaining seat. The creator already holds a color, so we only
// surface the opponent's invite link.
templ ShareLinksPanel(gameID, whiteToken, blackToken, myRole string) {
	{{
		var myColorLabel, myColorGlyph, oppColorLabel, oppColorGlyph, oppURL string
		if myRole == "white" {
			myColorLabel, myColorGlyph = "White", "♔"
			oppColorLabel, oppColorGlyph = "Black", "♚"
			oppURL = "/play/" + gameID + "?token=" + blackToken
		} else {
			myColorLabel, myColorGlyph = "Black", "♚"
			oppColorLabel, oppColorGlyph = "White", "♔"
			oppURL = "/play/" + gameID + "?token=" + whiteToken
		}
	}}
	<section class="bg-surface-1 border border-edge rounded-md p-4 flex flex-col gap-3" aria-label="Invite opponent">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div class="flex flex-col">
				<h2 class="text-sm font-semibold text-ink">Waiting for your opponent</h2>
				<p class="text-xs text-ink-muted">Clock starts when both players connect.</p>
			</div>
			<div class="flex items-center gap-2 text-xs">
				@colorBadge(myColorLabel, myColorGlyph, true)
				<span aria-hidden="true" class="text-ink-muted">vs</span>
				@colorBadge(oppColorLabel, oppColorGlyph, false)
			</div>
		</div>
		@opponentLinkRow(oppURL, oppColorLabel)
		<div
			class="flex items-center justify-between gap-2 px-3 py-2 bg-surface-3 border border-edge rounded"
			data-show="$joinDeadlineNs > 0"
			style="display:none"
			role="timer"
			aria-live="polite"
		>
			<span class="text-xs text-ink-muted">Game cancels if no one joins in</span>
			<span
				class="text-sm font-mono tabular-nums font-semibold text-accent"
				data-text="$joinSecondsLeft + 's'"
			></span>
		</div>
	</section>
}

templ colorBadge(label, glyph string, isMe bool) {
	if isMe {
		<span class="inline-flex items-center gap-1 px-2 py-1 rounded-sm bg-primary-50 border border-primary-200 text-primary font-medium">
			<span aria-hidden="true" class="text-base leading-none">{ glyph }</span>
			<span>{ label }</span>
		</span>
	} else {
		<span class="inline-flex items-center gap-1 px-2 py-1 rounded-sm bg-surface-3 border border-edge text-ink-subtle font-medium">
			<span aria-hidden="true" class="text-base leading-none">{ glyph }</span>
			<span>{ label }</span>
		</span>
	}
}

templ opponentLinkRow(url, oppColorLabel string) {
	{{
		copyJS := "(() => {" +
			"const t = location.origin + '" + url + "';" +
			"const b = event.currentTarget;" +
			"const done = () => { const o = b.dataset.origLabel || b.textContent; b.dataset.origLabel = o; b.textContent = 'Copied'; setTimeout(() => { b.textContent = o; }, 1500); };" +
			"const fallback = () => {" +
			"  const ta = document.createElement('textarea');" +
			"  ta.value = t; ta.setAttribute('readonly', '');" +
			"  ta.style.position = 'fixed'; ta.style.top = '0'; ta.style.left = '0'; ta.style.opacity = '0';" +
			"  document.body.appendChild(ta); ta.focus(); ta.select();" +
			"  try { document.execCommand('copy'); done(); } catch (e) {}" +
			"  document.body.removeChild(ta);" +
			"};" +
			"if (navigator.clipboard && window.isSecureContext) {" +
			"  navigator.clipboard.writeText(t).then(done).catch(fallback);" +
			"} else { fallback(); }" +
			"})()"
	}}
	<div class="flex gap-2 items-stretch">
		<input
			id="opponent-invite-link"
			type="text"
			readonly
			value={ url }
			data-attr-value={ templ.JSExpression("location.origin + '" + url + "'") }
			aria-label={ "Invite link for " + oppColorLabel + " player" }
			class="flex-1 min-w-0 text-xs bg-surface-3 border border-edge rounded px-3 py-2 text-ink-subtle select-all focus:outline-none focus:border-edge-strong"
			onfocus="this.select()"
		/>
		<button
			type="button"
			aria-label="Copy opponent invite link"
			class="text-xs font-medium px-4 py-2 bg-primary text-on-primary border border-primary rounded cursor-pointer hover:bg-primary-hover hover:border-primary-hover active:bg-primary-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 transition touch-manipulation select-none"
			data-on:click={ templ.JSExpression(copyJS) }
		>
			Copy
		</button>
	</div>
}
