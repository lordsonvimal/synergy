package components

import (
	"github.com/lordsonvimal/synergy/apps/chess/engine"
	"github.com/lordsonvimal/synergy/apps/chess/game"
)

// GameStatusRibbon is the always-visible strip above the board.
//
// While the game is in progress it shows the side to move (with a small
// chess-colored dot) and a "Check" badge when applicable. Once the game
// ends it switches to the winner + reason, paired with the king-square
// overlays painted on the board itself.
//
// Initial visibility and label text are rendered server-side from `g` so the
// post-hydration data-show / data-text passes don't cause a visible swap
// (e.g. "Black's turn" briefly appearing because `undefined === 0` is false).
templ GameStatusRibbon(g *game.Game) {
	{{
		inProgress := g.State == game.GameOngoing
		whiteToMove := g.Board.SideToMove == engine.White
		initialTurn := "Black's turn"
		if whiteToMove {
			initialTurn = "White's turn"
		}
		initialDotClass := "bg-[#1A1A1A]"
		if whiteToMove {
			initialDotClass = "bg-[#F5F5F5]"
		}
		// End-state initial label + reason (only rendered when !inProgress
		// so the SSR'd text matches the data-text expression's first eval).
		initialResult := "Draw"
		if g.Winner == engine.White {
			initialResult = "White wins"
		} else if g.Winner == engine.Black {
			initialResult = "Black wins"
		}
		initialReason := ""
		switch g.State {
		case game.GameCheckmate:
			initialReason = "Checkmate"
		case game.GameResigned:
			initialReason = "Resigned"
		case game.GameClockFlagged:
			initialReason = "Clock flagged"
		case game.GameDrawStalemate:
			initialReason = "Stalemate"
		case game.GameDrawFiftyMove:
			initialReason = "Fifty-move rule"
		case game.GameDrawAgreement:
			initialReason = "Draw by agreement"
		case game.GameDrawThreefoldRepetition:
			initialReason = "Threefold repetition"
		case game.GameDrawInsufficientMaterial:
			initialReason = "Insufficient material"
		case game.GameAbandoned:
			initialReason = "Abandoned"
		case game.GameDisconnected:
			initialReason = "Disconnected"
		}
	}}
	<div
		role="status"
		aria-live="polite"
		data-testid="game-status-ribbon"
		class="w-full h-[35px] flex items-center justify-center gap-2 px-3 bg-surface-0 border-b border-edge text-sm"
	>
		<!-- IN-PROGRESS: side-to-move dot + label, with optional "Check" badge. -->
		<div
			class="flex items-center gap-2"
			data-show="$gameState === 0"
			if !inProgress {
				style="display:none"
			}
		>
			<span
				aria-hidden="true"
				class={ "inline-block w-3 h-3 rounded-full border border-edge", initialDotClass }
				data-class={ templ.JSExpression(`{
					'bg-[#F5F5F5]': $sideToMove === 0,
					'bg-[#1A1A1A]': $sideToMove === 1,
				}`) }
			></span>
			<span
				class="font-semibold text-ink"
				data-text={ templ.JSExpression(`$sideToMove === 0 ? "White's turn" : "Black's turn"`) }
			>{ initialTurn }</span>
			<span
				class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded text-[0.7rem] font-bold uppercase tracking-wide bg-error/10 text-error"
				data-show="$checkSquare !== 64"
				style="display:none"
			>Check</span>
		</div>

		<!-- ENDED: winner + reason. -->
		<div
			class="flex items-center gap-2"
			data-show="$gameState !== 0"
			if inProgress {
				style="display:none"
			}
		>
			<span
				aria-hidden="true"
				class="inline-flex items-center justify-center w-5 h-5 rounded-full text-xs font-bold"
				data-class={ templ.JSExpression(`{
					'bg-error text-on-error':   $winner !== 255 && ($gameState === 1 || $gameState === 3),
					'bg-accent text-on-accent': $winner !== 255 && $gameState === 2,
					'bg-neutral-200 text-ink':  $winner === 255,
				}`) }
				data-text={ templ.JSExpression(`(() => {
					if ($winner === 255) return '½';
					if ($gameState === 1) return '#';
					if ($gameState === 2) return '⚑';
					if ($gameState === 3) return '⏱';
					return '✓';
				})()`) }
			></span>
			<span
				class="font-semibold text-ink"
				data-text={ templ.JSExpression(`$winner === 255 ? 'Draw' : ($winner === 0 ? 'White wins' : 'Black wins')`) }
			>{ initialResult }</span>
			<span
				class="text-ink-muted"
				data-text="'· ' + $gameStateText"
			>{ "· " + initialReason }</span>
		</div>
	</div>
}
