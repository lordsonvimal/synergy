package components

import (
	"fmt"
	"github.com/lordsonvimal/synergy/apps/chess/engine"
	"github.com/lordsonvimal/synergy/apps/chess/game"
	"github.com/lordsonvimal/synergy/apps/chess/ui/helpers"
)

// coordLabels renders the rank/file coordinate labels for a square.
// Both the live board and the read-only history board use this.
templ coordLabels(rank, file int, coordColor, coordShadow string) {
	// Rank label (White view): top-left corner of every a-file square.
	if file == 0 {
		<span
			class={ coordColor, coordShadow, "absolute top-0.5 left-0.5 text-xs font-bold leading-none pointer-events-none select-none z-20" }
			data-show="!$flipped"
			aria-hidden="true"
		>{ fmt.Sprintf("%d", rank+1) }</span>
	}
	// Rank label (Black view): top-left corner of every h-file square after flip.
	if file == 7 {
		<span
			class={ coordColor, coordShadow, "absolute top-0.5 left-0.5 text-xs font-bold leading-none pointer-events-none select-none z-20" }
			data-show="$flipped"
			style="display: none"
			aria-hidden="true"
		>{ fmt.Sprintf("%d", rank+1) }</span>
	}
	// File label (White view): bottom-right corner of each first-rank square.
	if rank == 0 {
		<span
			class={ coordColor, coordShadow, "absolute bottom-0.5 right-0.5 text-xs font-bold leading-none pointer-events-none select-none z-20" }
			data-show="!$flipped"
			aria-hidden="true"
		>{ string(rune('a' + file)) }</span>
	}
	// File label (Black view): bottom-right corner of each eighth-rank square after flip.
	if rank == 7 {
		<span
			class={ coordColor, coordShadow, "absolute bottom-0.5 right-0.5 text-xs font-bold leading-none pointer-events-none select-none z-20" }
			data-show="$flipped"
			style="display: none"
			aria-hidden="true"
		>{ string(rune('a' + file)) }</span>
	}
}

templ RenderChessSquare(g *game.Game, rank int, file int, routePrefix string) {
	{{
		// rank 0, file 0 now equals 0 (A1)
		// rank 7, file 0 now equals 56 (A8)
		sq := uint8(rank*8 + file)
		color, piece, ok := g.Board.PieceAt(sq)

		id := fmt.Sprintf("square-%d", sq)

		bg := "bg-[var(--chess-light)]"
		if (rank+file)%2 == 0 {
			bg = "bg-[var(--chess-dark)]"
		}

		// Coordinate label colour: contrast against the square background.
		// Colors are CSS vars per board palette (see style.css :root) so the
		// labels track the active [data-board-theme]. Shadow only on dark
		// squares for separation.
		coordColor := "text-[var(--chess-coord-on-light)]"
		coordShadow := ""
		if (rank+file)%2 == 0 {
			coordColor = "text-[var(--chess-coord-on-dark)]"
			coordShadow = "[text-shadow:0_1px_2px_rgba(0,0,0,0.5)]"
		}

		// Click + keyboard both delegate to board.js, which runs chessops
		// client-side: highlights appear instantly with no server round-trip,
		// and the actual move is only POSTed once the user picks a legal
		// destination (see assets/js/board.js → onSquareClick).
		clickExpr := fmt.Sprintf("window.__chessleap && window.__chessleap.onSquareClick(%d)", sq)
		onClick := templ.JSExpression(clickExpr)
		onKey := templ.JSExpression("(event.key === 'Enter' || event.key === ' ') && (event.preventDefault(), " + clickExpr + ")")
		label := helpers.SquareLabel(sq, color, piece, ok)
		_ = routePrefix // routePrefix is read from #chessboard data-* by board.js
	}}
	{{
		// Dot/ring color depends on the square's own light/dark tone so the
		// indicator reads on both. Computed once at render time.
		isDark := (rank+file)%2 == 0
		dotBg := "bg-black/20"
		ringBg := "bg-[radial-gradient(circle,transparent_58%,rgb(0_0_0/0.22)_62%)]"
		if isDark {
			dotBg = "bg-white/25"
			ringBg = "bg-[radial-gradient(circle,transparent_58%,rgb(255_255_255/0.28)_62%)]"
		}
		// Per-square reactive conditions, evaluated once and reused below.
		// Dot-vs-ring branches on the server-side `ok` flag — the board is
		// morphed via SSE after every move, so occupancy stays in sync.
		isSelected := fmt.Sprintf("$selectedSquare === %d", sq)
		hasMoves := "($possibleMoves || []).length > 0"
		isTarget := fmt.Sprintf("($possibleMoves || []).includes(%d) && $selectedSquare !== %d", sq, sq)
		ended := "$gameState !== 0"
		isWhiteKing := fmt.Sprintf("%d === $whiteKingSq", sq)
		isBlackKing := fmt.Sprintf("%d === $blackKingSq", sq)
	}}
	<div
		id={ id }
		data-testid={ id }
		role="button"
		tabindex="0"
		aria-label={ label }
		class={ bg, "relative isolate flex items-center justify-center leading-none font-['DejaVu_Sans'] cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-inset text-[clamp(1.25rem,4vw,2.5rem)] select-none" }
		data-on:click={ onClick }
		data-on:keydown={ onKey }
		data-class="{'rotate-180': $flipped}"
	>
		<!-- Selection overlays (mutually exclusive). -->
		<div
			class="absolute inset-0 pointer-events-none bg-[rgb(255_213_79_/_0.55)]"
			data-show={ isSelected + " && " + hasMoves }
			style="display:none"
		></div>
		<div
			class="absolute inset-0 pointer-events-none shadow-[inset_0_0_0_2px_rgb(255_213_79_/_0.9)]"
			data-show={ isSelected + " && !(" + hasMoves + ")" }
			style="display:none"
		></div>

		<!-- Legal-move target dot (empty square) / ring (capture). -->
		if !ok {
			<div
				class={ "absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[28%] h-[28%] rounded-full pointer-events-none", dotBg }
				data-show={ isTarget }
				style="display:none"
			></div>
		} else {
			<div
				class={ "absolute inset-0 pointer-events-none", ringBg }
				data-show={ isTarget }
				style="display:none"
			></div>
		}

		<!-- Check overlay (live game only). -->
		<div
			class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle,rgb(220_38_38/0.65)_0%,rgb(220_38_38/0.15)_60%,transparent_80%)]"
			data-show={ "!(" + ended + ") && $checkSquare === " + fmt.Sprintf("%d", sq) }
			style="display:none"
		></div>

		<!-- Game-end king overlays (mutually exclusive). -->
		<!-- Loser: dense red wash so the square reads as "this is where it ended". -->
		<div
			class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle,rgb(220_38_38/0.95)_0%,rgb(220_38_38/0.6)_55%,rgb(220_38_38/0.25)_90%)]"
			data-show={ ended + " && $winner !== 255 && ((" + isBlackKing + " && $winner === 0) || (" + isWhiteKing + " && $winner === 1))" }
			style="display:none"
		></div>
		<!-- Winner: thin/light green ring — quiet badge of victory. -->
		<div
			class="absolute inset-0 pointer-events-none shadow-[inset_0_0_0_2px_rgb(21_128_61/0.6)]"
			data-show={ ended + " && $winner !== 255 && ((" + isWhiteKing + " && $winner === 0) || (" + isBlackKing + " && $winner === 1))" }
			style="display:none"
		></div>
		<div
			class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle,rgb(148_163_184/0.55)_0%,rgb(148_163_184/0.15)_65%,transparent_85%)]"
			data-show={ ended + " && $winner === 255 && (" + isWhiteKing + " || " + isBlackKing + ")" }
			style="display:none"
		></div>

		if ok {
			@RenderChessPiece(color, piece)
		}
		@coordLabels(rank, file, coordColor, coordShadow)
		@endGlyph(sq, isWhiteKing, isBlackKing, ended)
	</div>
}

// endGlyph renders a small status badge on the king's square once the game
// ends — same visual language as the ribbon icon (filled circle with a
// glyph inside) so the two reinforce each other. Loser gets a red badge,
// draw kings get a neutral gray badge; the winner has nothing here because
// the green ring is the win signal.
templ endGlyph(sq uint8, isWhiteKing, isBlackKing, ended string) {
	{{
		isLoser := "$winner !== 255 && ((" + isBlackKing + " && $winner === 0) || (" + isWhiteKing + " && $winner === 1))"
		isDraw := "$winner === 255 && (" + isWhiteKing + " || " + isBlackKing + ")"
	}}
	<span
		aria-hidden="true"
		class="absolute bottom-0.5 left-0.5 inline-flex items-center justify-center w-[25%] h-[25%] rounded-full font-black text-[0.65rem] sm:text-xs leading-none pointer-events-none z-20 ring-2"
		data-show={ ended + " && (" + isLoser + " || " + isDraw + ")" }
		style="display:none"
		data-class={ templ.JSExpression(`{
			'rotate-180': $flipped,
			'bg-error text-on-error': ` + isLoser + `,
			'bg-neutral-500 text-white': ` + isDraw + `,
		}`) }
		data-text={ templ.JSExpression(`(() => {
			if ($winner === 255) return '½';
			if ($gameState === 1) return '#';
			if ($gameState === 2) return '⚐';
			if ($gameState === 3) return '⏱';
			return '';
		})()`) }
	></span>
}

// RenderReadOnlyChessSquare renders a non-interactive history board square
// with the piece from the given display board. Coord labels are included.
templ RenderReadOnlyChessSquare(board *engine.Board, rank int, file int) {
	{{
		sq := uint8(rank*8 + file)
		color, piece, ok := board.PieceAt(sq)

		bg := "bg-[var(--chess-light)]"
		if (rank+file)%2 == 0 {
			bg = "bg-[var(--chess-dark)]"
		}

		coordColor := "text-[#B58863]"
		coordShadow := ""
		if (rank+file)%2 == 0 {
			coordColor = "text-[#F0D9B5]"
			coordShadow = "[text-shadow:0_1px_2px_rgba(0,0,0,0.5)]"
		}
	}}
	<div
		class={ bg, "relative flex items-center justify-center leading-none font-['DejaVu_Sans'] text-[clamp(1.25rem,4vw,2.5rem)] select-none" }
		data-class="{'rotate-180': $flipped}"
	>
		if ok {
			@RenderChessPiece(color, piece)
		}
		@coordLabels(rank, file, coordColor, coordShadow)
	</div>
}
