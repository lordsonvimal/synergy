package components

// RematchPrompt renders a banner shown to the player who received a rematch proposal.
templ RematchPrompt(gameID, csrfToken string) {
	<div class="bg-surface border border-edge rounded-md p-4 flex flex-col gap-3">
		<div class="flex items-center justify-between">
			<p class="text-sm font-semibold text-ink">Your opponent wants a rematch</p>
			<span class="text-xs text-ink-dim tabular-nums"><span data-text="$rematchSecondsLeft"></span>s</span>
		</div>
		<div class="flex gap-3">
			<!-- Accept navigates to the new game so it needs a full form POST + redirect. -->
			<form method="POST" action={ templ.SafeURL("/play/" + gameID + "/rematch/accept") }>
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				<button
					type="submit"
					class="px-4 py-2 text-sm font-medium bg-primary text-on-primary rounded-md hover:bg-primary-hover transition cursor-pointer"
				>Accept</button>
			</form>
			<!-- Decline sends a fire-and-forget POST; state update arrives via SSE. -->
			<button
				type="button"
				data-on:click={ templ.JSExpression("@post('/play/" + gameID + "/rematch/decline')") }
				class="px-4 py-2 text-sm font-medium text-error border border-error rounded-md hover:bg-error-subtle transition cursor-pointer"
			>Decline</button>
		</div>
	</div>
}

// RematchPending renders a banner shown to the player who proposed a rematch.
templ RematchPending(gameID, csrfToken string) {
	<div class="bg-surface border border-edge rounded-md p-4 flex flex-col gap-3">
		<div class="flex items-center justify-between">
			<p class="text-sm font-semibold text-ink">Rematch requested</p>
			<span class="text-xs text-ink-dim tabular-nums"><span data-text="$rematchSecondsLeft"></span>s</span>
		</div>
		<!-- Opponent online: waiting message -->
		<p
			class="text-xs text-ink-dim"
			data-show="($role === 'white' && $blackOnline) || ($role === 'black' && $whiteOnline)"
		>Waiting for opponent to respond...</p>
		<!-- Opponent offline: offline message -->
		<p
			class="text-xs text-ink-dim"
			data-show="($role === 'white' && !$blackOnline) || ($role === 'black' && !$whiteOnline)"
			style="display:none"
		>Opponent is offline. Request will expire when the timer runs out.</p>
		<button
			type="button"
			data-on:click={ templ.JSExpression("@post('/play/" + gameID + "/rematch/decline')") }
			class="self-start px-3 py-1.5 text-xs font-medium text-error border border-error rounded-md hover:bg-error-subtle transition cursor-pointer"
		>Cancel</button>
	</div>
}
