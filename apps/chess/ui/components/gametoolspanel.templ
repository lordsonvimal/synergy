package components

// GameToolsPanel — compact icon row beneath the move notation.
//
// Layout: [Flip] [spacer] [More menu (Claim / Rematch)]
// Result text is no longer shown here; the result lives in the ribbon above
// the board plus the king-square overlays.
templ GameToolsPanel(gameID, role, csrfToken string) {
	<div
		data-testid="game-tools-panel"
		data-signals.ifmissing='{"toolsMenuOpen": false}'
		class="flex items-center gap-2 p-1 bg-surface-1 border-t border-edge"
	>
		<!-- Flip board (icon only) -->
		<button
			data-testid="flip-board-button"
			aria-label="Flip board orientation"
			data-on:click="$flipped = !$flipped"
			class="inline-flex items-center justify-center w-11 h-11 rounded-md text-ink-subtle hover:bg-surface-4 hover:text-ink transition-colors duration-150 cursor-pointer shrink-0"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="w-6 h-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M7 16V4m0 0L3 8m4-4l4 4"></path>
				<path d="M17 8v12m0 0l4-4m-4 4l-4-4"></path>
			</svg>
		</button>

		<!-- Sound on/off (icon only) -->
		@SoundToggle()

		<!-- Board color cycle (icon only) -->
		@BoardColorToggle()

		if gameID != "" && (role == "white" || role == "black") {
			<!-- In-game action icons: always rendered while game is ongoing,
			     greyed-out + non-interactive when not actionable. -->
			{{
				drawDisabled := "$gameState !== 0 || !$clockUnlocked || $drawOffered || $drawPending || ($role === 'white' ? $lastDrawSeqWhite === $seq : $lastDrawSeqBlack === $seq)"
				takebackDisabled := "$gameState !== 0 || !$clockUnlocked || $takebackOffered || $takebackPending || !(($role === 'white' && $sideToMove === 1) || ($role === 'black' && $sideToMove === 0)) || ($role === 'white' ? $lastTakebackSeqWhite === $seq : $lastTakebackSeqBlack === $seq)"
				resignDisabled := "$gameState !== 0 || !$clockUnlocked"
			}}
			<button
				type="button"
				aria-label="Offer draw"
				title="Offer draw"
				data-on:click={ templ.JSExpression("@post('/play/" + gameID + "/draw')") }
				data-attr-disabled={ templ.JSExpression(drawDisabled) }
				data-class={ templ.JSExpression("{'opacity-30 pointer-events-none': " + drawDisabled + "}") }
				class="inline-flex items-center justify-center w-11 h-11 rounded-md text-ink-subtle hover:bg-surface-4 hover:text-ink transition-colors duration-150 cursor-pointer shrink-0"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="9"></circle>
					<text x="12" y="16" text-anchor="middle" font-size="10" font-weight="700" fill="currentColor" stroke="none">½</text>
				</svg>
			</button>

			<button
				type="button"
				aria-label="Request takeback"
				title="Request takeback"
				data-on:click={ templ.JSExpression("@post('/play/" + gameID + "/takeback')") }
				data-attr-disabled={ templ.JSExpression(takebackDisabled) }
				data-class={ templ.JSExpression("{'opacity-30 pointer-events-none': " + takebackDisabled + "}") }
				class="inline-flex items-center justify-center w-11 h-11 rounded-md text-ink-subtle hover:bg-surface-4 hover:text-ink transition-colors duration-150 cursor-pointer shrink-0"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M3 7v6h6"></path>
					<path d="M3 13a9 9 0 1 0 3-6.7L3 9"></path>
				</svg>
			</button>

			<button
				type="button"
				aria-label="Resign"
				title="Resign"
				data-on:click="$resignConfirm = true"
				data-attr-disabled={ templ.JSExpression(resignDisabled) }
				data-class={ templ.JSExpression("{'opacity-30 pointer-events-none': " + resignDisabled + "}") }
				class="inline-flex items-center justify-center w-11 h-11 rounded-md text-ink-subtle hover:bg-error-subtle hover:text-error transition-colors duration-150 cursor-pointer shrink-0"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M4 21V4"></path>
					<path d="M4 4h12l-2 4 2 4H4"></path>
				</svg>
			</button>
		}

		<div class="flex-1"></div>

		if gameID != "" && (role == "white" || role == "black") {
			<div class="relative">
				<!-- Post-game menu: claim-victory + propose-rematch. -->
				<button
					type="button"
					aria-label="More game actions"
					aria-haspopup="menu"
					data-attr-aria-expanded="$toolsMenuOpen"
					data-on:click="$toolsMenuOpen = !$toolsMenuOpen"
					data-show="$claimVictory || ($gameState !== 0 && !$rematchProposed && !$rematchPending)"
					style="display:none"
					class="inline-flex items-center justify-center w-11 h-11 rounded-md text-ink-subtle hover:bg-surface-4 hover:text-ink transition-colors duration-150 cursor-pointer shrink-0"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<circle cx="5" cy="12" r="1.6"></circle>
						<circle cx="12" cy="12" r="1.6"></circle>
						<circle cx="19" cy="12" r="1.6"></circle>
					</svg>
				</button>
				<!-- Click-outside dismiss: backdrop sits behind the menu, transparent. -->
				<div
					data-show="$toolsMenuOpen"
					style="display:none"
					class="fixed inset-0 z-30"
					data-on:click="$toolsMenuOpen = false"
				></div>
				<div
					role="menu"
					data-show="$toolsMenuOpen"
					style="display:none"
					class="absolute right-0 bottom-full mb-1 w-44 bg-surface-0 border border-edge rounded-md shadow-md py-1 z-40"
				>
					<button
						type="button"
						role="menuitem"
						data-on:click={ templ.JSExpression("$toolsMenuOpen = false; @post('/play/" + gameID + "/claim-victory')") }
						data-show="$claimVictory"
						style="display:none"
						class="w-full text-left px-3 py-1.5 text-xs text-ink hover:bg-surface-4 cursor-pointer"
					>Claim victory</button>
					<button
						type="button"
						role="menuitem"
						data-on:click={ templ.JSExpression("$toolsMenuOpen = false; @post('/play/" + gameID + "/rematch')") }
						data-show="$gameState !== 0 && !$rematchProposed && !$rematchPending"
						style="display:none"
						class="w-full text-left px-3 py-1.5 text-xs text-ink hover:bg-surface-4 cursor-pointer"
					>Propose rematch</button>
				</div>
			</div>
		}
	</div>
}
