package components

// BoardColorToggle — icon button that cycles the chess board palette
// between brown (default), green, and black/white. State is stored in
// localStorage under "chess-board-theme" and applied to <html> as the
// data-board-theme attribute. The initial value is applied pre-paint by
// the head script in layout.templ to avoid a palette flash on load.
templ BoardColorToggle() {
	<button
		id="board-color-toggle"
		data-testid="board-color-toggle"
		type="button"
		aria-label="Cycle board color"
		class="inline-flex items-center justify-center w-11 h-11 rounded-md text-ink-subtle hover:bg-surface-4 hover:text-ink transition-colors duration-150 cursor-pointer shrink-0"
		onclick="cycleChessBoardTheme()"
	>
		<span id="board-color-toggle-icon" class="inline-flex"></span>
	</button>
	<script>
		(function () {
			const ORDER = ["brown", "green", "bw"];
			const SWATCH = {
				brown: { light: "#F0D9B5", dark: "#B58863" },
				green: { light: "#EEEED2", dark: "#769656" },
				bw:    { light: "#FFFFFF", dark: "#8A8A8A" },
			};

			function current() {
				const v = localStorage.getItem("chess-board-theme");
				return ORDER.indexOf(v) >= 0 ? v : "green";
			}
			function swatchSVG(theme) {
				const c = SWATCH[theme];
				return '<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 16 16" aria-hidden="true">' +
					'<rect x="0" y="0" width="8" height="8" fill="' + c.light + '"></rect>' +
					'<rect x="8" y="0" width="8" height="8" fill="' + c.dark  + '"></rect>' +
					'<rect x="0" y="8" width="8" height="8" fill="' + c.dark  + '"></rect>' +
					'<rect x="8" y="8" width="8" height="8" fill="' + c.light + '"></rect>' +
					'<rect x="0.5" y="0.5" width="15" height="15" fill="none" stroke="currentColor" stroke-opacity="0.4" stroke-width="1"></rect>' +
					'</svg>';
			}
			function paint() {
				const theme = current();
				document.documentElement.setAttribute("data-board-theme", theme);
				const el = document.getElementById("board-color-toggle-icon");
				if (el) el.innerHTML = swatchSVG(theme);
				const btn = document.getElementById("board-color-toggle");
				if (btn) btn.setAttribute("aria-valuetext", theme);
			}
			window.cycleChessBoardTheme = function () {
				const next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length];
				localStorage.setItem("chess-board-theme", next);
				paint();
			};
			paint();
		})();
	</script>
}
