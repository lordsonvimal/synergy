package components

import (
	"github.com/lordsonvimal/synergy/apps/chess/engine"
	"github.com/lordsonvimal/synergy/apps/chess/ui/helpers"
)

templ RenderChessPiece(color engine.Color, piece engine.Piece) {
	{{
		label := helpers.ColorName(color) + " " + helpers.PieceName(piece)
	}}
	<span aria-label={ label } role="img">
		if color == engine.White {
			switch piece {
				case engine.Pawn:
					♙
				case engine.Knight:
					♘
				case engine.Bishop:
					♗
				case engine.Rook:
					♖
				case engine.Queen:
					♕
				case engine.King:
					♔
			}
		} else {
			switch piece {
				case engine.Pawn:
					♟
				case engine.Knight:
					♞
				case engine.Bishop:
					♝
				case engine.Rook:
					♜
				case engine.Queen:
					♛
				case engine.King:
					♚
			}
		}
	</span>
}
