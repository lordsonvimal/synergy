package components

import (
	"fmt"
	"strings"
	"github.com/lordsonvimal/synergy/apps/chess/engine"
	"github.com/lordsonvimal/synergy/apps/chess/game"
	"github.com/lordsonvimal/synergy/apps/chess/ui/helpers"
)

templ PromotionButton(g *game.Game, piece engine.Piece, routePrefix string) {
	{{
		color := g.Board.SideToMove
		// Set the chosen piece on signals so board.js can read it, then hand
		// control back to board.js to apply the move optimistically (DOM swap
		// + POST). board.js clears the promotion signals afterwards.
		onClick := templ.JSExpression(fmt.Sprintf(`$promotionPiece = %d; window.__chessleap && window.__chessleap.resumeAfterPromotion(%d)`, piece, piece))
		label := "Promote to " + helpers.PieceName(piece)
		_ = routePrefix
	}}
	<button
		data-testid={ "promotion-button-" + strings.ToLower(helpers.PieceName(piece)) }
		class="w-10 h-10 sm:w-12 sm:h-12 text-2xl sm:text-3xl hover:bg-[#1A1A1A]/10 rounded-md cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary"
		aria-label={ label }
		data-on:click={ onClick }
	>
		@RenderChessPiece(color, piece)
	</button>
}
