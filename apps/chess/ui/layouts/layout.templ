package layouts

import (
	"github.com/lordsonvimal/synergy/apps/chess/ui/components"
	"github.com/lordsonvimal/synergy/apps/chess/ui/helpers"
)

templ Layout(title string, showBack bool) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" type="image/svg+xml" href={ helpers.Asset("favicon.svg") }/>
			<link href={ helpers.Asset("style.css") } rel="stylesheet"/>
			<!-- One copy of the datastar runtime per page, exposed via importmap
			     so bundles like initClock.js and board.js can `import ... from "datastar"`
			     without each shipping its own runtime. -->
			@datastarImportMap()
			<script type="module" src={ helpers.Asset("js/datastar.js") }></script>
			<script>
				(function() {
					const t = localStorage.getItem("theme");
					if (t) { document.documentElement.setAttribute("data-theme", t); }
					else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
						document.documentElement.setAttribute("data-theme", "dark");
					}
				})();
			</script>
		</head>
		<body class="bg-neutral-50 text-ink h-full flex flex-col">
			<header
				class="flex items-center justify-between px-4 py-3 border-b border-edge bg-surface-1 shrink-0"
				data-signals.ifmissing='{"menuOpen": false}'
			>
				<div class="flex items-center gap-2">
					if showBack {
						<a href="/" class="sm:hidden p-1 rounded-md hover:bg-surface-4 text-ink-subtle transition" aria-label="Back to home">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg>
						</a>
					}
					<a href="/" class="flex items-center gap-2 text-lg font-semibold text-ink tracking-tight">
						<img src={ helpers.Asset("favicon.svg") } alt="ChessLeap logo" width="28" height="28" class="rounded-md"/>
						ChessLeap
					</a>
				</div>
				<!-- Desktop nav -->
				<nav class="hidden sm:flex items-center gap-1" aria-label="Main navigation">
					<a href="/" class="px-3 py-1.5 text-sm font-medium text-primary bg-primary-subtle rounded-md">Play</a>
					<span class="px-3 py-1.5 text-sm font-medium text-ink-muted cursor-not-allowed select-none" aria-disabled="true" title="Coming soon">Practice</span>
					<span class="px-3 py-1.5 text-sm font-medium text-ink-muted cursor-not-allowed select-none" aria-disabled="true" title="Coming soon">Class</span>
				</nav>
				<div class="flex items-center gap-2">
					@components.ThemeToggle()
					<!-- Mobile hamburger -->
					<button
						class="sm:hidden p-1.5 rounded-md hover:bg-surface-4 text-ink-subtle transition"
						data-on:click="$menuOpen = !$menuOpen"
						aria-label="Toggle navigation menu"
					>
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<line x1="3" y1="6" x2="21" y2="6"></line>
							<line x1="3" y1="12" x2="21" y2="12"></line>
							<line x1="3" y1="18" x2="21" y2="18"></line>
						</svg>
					</button>
				</div>
			</header>
			<!-- Mobile dropdown nav -->
			<div
				class="sm:hidden border-b border-edge bg-surface-1 shrink-0"
				data-show="$menuOpen"
				style="display:none"
			>
				<nav class="px-4 py-2 flex flex-col gap-1" aria-label="Mobile navigation">
					<a href="/" class="px-3 py-2 text-sm font-medium text-primary bg-primary-subtle rounded-md">Play</a>
					<span class="px-3 py-2 text-sm font-medium text-ink-muted cursor-not-allowed select-none">
						Practice <span class="text-xs">(coming soon)</span>
					</span>
					<span class="px-3 py-2 text-sm font-medium text-ink-muted cursor-not-allowed select-none">
						Class <span class="text-xs">(coming soon)</span>
					</span>
				</nav>
			</div>
			<main class="flex-1 overflow-auto">
				{ children... }
			</main>
			<div
				id="offline-banner"
				class="hidden shrink-0 items-center justify-center gap-2 border-t border-warning bg-warning-subtle px-4 py-2 text-sm font-medium text-warning"
				role="status"
				aria-live="polite"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="1" y1="1" x2="23" y2="23"></line>
					<path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"></path>
					<path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"></path>
					<path d="M10.71 5.05A16 16 0 0 1 22.56 9"></path>
					<path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"></path>
					<path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
					<line x1="12" y1="20" x2="12.01" y2="20"></line>
				</svg>
				No internet connection — changes will not be saved until reconnected
			</div>
			<script>
				(function () {
					var banner = document.getElementById('offline-banner');
					function update() {
						banner.style.display = navigator.onLine ? 'none' : 'flex';
					}
					window.addEventListener('online', update);
					window.addEventListener('offline', update);
					update();
				})();
			</script>
			<footer class="shrink-0 border-t border-edge bg-surface-1 px-4 py-2 flex items-center justify-between">
				<span class="text-xs text-ink-muted">ChessLeap</span>
				<span class="text-xs text-ink-muted">v0.1.0</span>
			</footer>
		</body>
	</html>
}

templ datastarImportMap() {
	@templ.Raw(`<script type="importmap">` + datastarImportMapJSON() + `</script>`)
}
