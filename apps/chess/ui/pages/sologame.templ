package pages

import "github.com/lordsonvimal/synergy/apps/chess/game"
import "github.com/lordsonvimal/synergy/apps/chess/ui/components"
import "github.com/lordsonvimal/synergy/apps/chess/ui/helpers"
import "github.com/lordsonvimal/synergy/apps/chess/ui/layouts"
import "github.com/lordsonvimal/synergy/apps/chess/ui/ui_store"

templ SoloGamePage(g *game.Game) {
	@layouts.Layout("ChessLeap", true) {
		<!-- datastar runtime is loaded once in layouts.Layout via the importmap -->
		<script type="module" src={ helpers.Asset("js/initClock.js") }></script>
		<script type="module" src={ helpers.Asset("js/board.js") }></script>
		<!-- data-init opens a persistent datastar @get to /events. All clock
		     ticks, game-over and history-clock signals arrive over this single
		     SSE connection (replaces the former native EventSource). -->
		<div class="hidden" data-init={ "@get('/solo/" + g.ID + "/events')" }></div>
		<div
			class="flex flex-col items-center justify-start min-h-full sm:p-4 sm:gap-3"
			data-signals={ templ.JSONString(ui_store.ChessBoardSignalsFromGame(g)) }
		>
			@components.GameStatusBanner()

			<div class="w-full sm:w-[min(100%,calc(100vh-16rem),540px)] flex flex-col border-y sm:border border-edge sm:rounded-sm overflow-hidden sm:shadow-2xl">
				@components.GameStatusRibbon(g)
				<div class="flex flex-col">
					@components.BlackPlayerCard()
					<section class="relative w-full">
						@components.RenderChessBoard(g, "/solo")
						@components.RenderPromotionOverlay(g, "/solo")
						<div
							class="absolute inset-0 z-10"
							data-show="$viewingHistory"
							data-signals.ifmissing='{"historyIdx": -1, "viewingHistory": false}'
							style="display:none"
						>
							<div id="history-board-content" class="w-full h-full"></div>
						</div>
					</section>
					@components.WhitePlayerCard()
				</div>
				@components.MoveNotationPanel("/solo", g.ID, g.History)
				@components.GameToolsPanel("", "", "")
			</div>
		</div>
	}
}
