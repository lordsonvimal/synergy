package pages

import "github.com/lordsonvimal/synergy/apps/chess/game"
import "github.com/lordsonvimal/synergy/apps/chess/ui/helpers"

templ GameModesPage(modes []game.GameMode) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<title>ChessLab — Game Modes</title>
			<link href="/static/style.css" rel="stylesheet"/>
		</head>
		<body class="bg-canvas min-h-screen flex items-center justify-center">
			<div class="w-full max-w-2xl p-6">
				<h1 class="text-3xl font-bold text-center mb-6">
					Choose a Game Mode
				</h1>
				<div class="grid gap-4">
					for _, mode := range modes {
						<form method="POST" action="/game">
							<input type="hidden" name="mode" value={ mode.Name }/>
							<button
								type="submit"
								class="w-full bg-surface rounded-md shadow-sm border border-edge p-4 text-left
								   hover:bg-primary-subtle hover:shadow-md transition"
							>
								<div class="flex justify-between items-center">
									<div>
										<div class="text-lg font-semibold">
											{ mode.Name }
										</div>
										<div class="text-sm text-ink-secondary">
											{ mode.Variant }
										</div>
									</div>
									<div class="text-sm text-ink-dim">
										{ helpers.FormatTime(mode.TimeNs) } + { helpers.FormatInc(mode.Increment) }
									</div>
								</div>
							</button>
						</form>
					}
				</div>
			</div>
		</body>
	</html>
}
