package pages

import (
	"fmt"
	"github.com/lordsonvimal/synergy/apps/chess/game"
	"github.com/lordsonvimal/synergy/apps/chess/ui/helpers"
	"github.com/lordsonvimal/synergy/apps/chess/ui/layouts"
)

templ GameModesPage(modes []game.GameMode, csrfToken string, errMsg string) {
	@layouts.Layout("ChessLeap — Game Modes", false) {
		<script type="module" src="/assets/datastar.js"></script>
		<div data-signals="{loadingMode: -1}" class="flex items-center justify-center min-h-full">
			<div class="w-full max-w-2xl px-4 py-6 sm:px-6">
				<h1 class="text-2xl font-bold text-ink mb-6">Choose a Game Mode</h1>
				if errMsg != "" {
					<div
						data-testid="error-banner"
						class="flex items-center gap-2 px-4 py-3 rounded-lg bg-error-subtle border border-error text-error text-sm mb-6"
						role="alert"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
							<line x1="12" y1="9" x2="12" y2="13"></line>
							<line x1="12" y1="17" x2="12.01" y2="17"></line>
						</svg>
						{ errMsg }
					</div>
				}
				if len(modes) == 0 {
					<div data-testid="empty-state" class="flex flex-col items-center gap-4 py-16 text-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-ink-dim" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<div>
							<p class="font-semibold text-ink text-lg">No game modes available</p>
							<p class="text-ink-secondary text-sm mt-1">Please check back later or refresh the page.</p>
						</div>
						<a
							href="/"
							class="px-4 py-2 text-sm font-medium text-on-primary bg-primary rounded-md hover:bg-primary-hover transition-colors duration-150"
						>Refresh</a>
					</div>
				} else {
					<div class="grid gap-4">
						for i, mode := range modes {
							<form method="POST" action="/game">
								<input type="hidden" name="_csrf" value={ csrfToken }/>
								<input type="hidden" name="mode" value={ mode.Name }/>
								<button
									data-testid={ fmt.Sprintf("game-mode-button-%d", i) }
									type="submit"
									data-on:click={ templ.JSExpression(fmt.Sprintf("$loadingMode = %d", i)) }
									data-attr:disabled={ templ.JSExpression(fmt.Sprintf("$loadingMode !== -1 && $loadingMode !== %d", i)) }
									data-class={ templ.JSExpression(fmt.Sprintf(`
										(() => {
											const active = $loadingMode === %d;
											const blocked = $loadingMode !== -1 && $loadingMode !== %d;
											return {
												'opacity-50 cursor-not-allowed pointer-events-none': blocked,
												'bg-primary-subtle border-primary cursor-wait': active,
												'hover:bg-primary-subtle hover:shadow-md cursor-pointer': !active && !blocked,
											};
										})()
									`, i, i)) }
									class="w-full bg-surface rounded-md shadow-sm border border-edge p-4 text-left transition"
								>
									<div class="flex justify-between items-center gap-3">
										<div class="min-w-0">
											<div class="text-lg font-semibold text-ink truncate">{ mode.Name }</div>
											<div class="text-sm text-ink-secondary">{ mode.Variant }</div>
										</div>
										<div class="text-sm text-ink-dim whitespace-nowrap shrink-0">
											{ helpers.FormatTime(mode.TimeNs) } + { helpers.FormatInc(mode.Increment) }
										</div>
									</div>
								</button>
							</form>
						}
					</div>
				}
			</div>
		</div>
	}
}
