package pages

import (
	"fmt"
	"github.com/lordsonvimal/synergy/apps/chess/game"
	"github.com/lordsonvimal/synergy/apps/chess/ui/helpers"
	"github.com/lordsonvimal/synergy/apps/chess/ui/layouts"
)

templ GameModesPage(modes []game.GameMode, csrfToken string, errMsg string, existingGameID string, existingGameRole string) {
	@layouts.Layout("ChessLeap", false) {
		<script type="module" src="/assets/datastar.js"></script>
		<div data-signals="{loadingMode: -1, activeTab: 'online'}" class="flex items-center justify-center min-h-full">
			<div class="w-full max-w-2xl px-4 py-6 sm:px-6">
				if errMsg != "" {
					<div
						data-testid="error-banner"
						class="flex items-center gap-2 px-4 py-3 rounded-lg bg-error-subtle border border-error text-error text-sm mb-6"
						role="alert"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
							<line x1="12" y1="9" x2="12" y2="13"></line>
							<line x1="12" y1="17" x2="12.01" y2="17"></line>
						</svg>
						{ errMsg }
					</div>
				}

				<!-- Tab switcher -->
				<div class="flex gap-1 mb-6 bg-surface-4 rounded-lg p-1">
					<button
						type="button"
						data-on:click="$activeTab = 'online'"
						data-class="{'bg-surface-1 shadow-sm text-ink': $activeTab === 'online', 'text-ink-subtle hover:bg-surface-4': $activeTab !== 'online'}"
						class="flex-1 py-2 text-sm font-medium rounded-md transition cursor-pointer"
					>Online</button>
					<button
						type="button"
						data-on:click="$activeTab = 'computer'"
						data-class="{'bg-surface-1 shadow-sm text-ink': $activeTab === 'computer', 'text-ink-subtle hover:bg-surface-4': $activeTab !== 'computer'}"
						class="flex-1 py-2 text-sm font-medium rounded-md transition cursor-pointer"
					>Computer</button>
					<button
						type="button"
						data-on:click="$activeTab = 'self'"
						data-class="{'bg-surface-1 shadow-sm text-ink': $activeTab === 'self', 'text-ink-subtle hover:bg-surface-4': $activeTab !== 'self'}"
						class="flex-1 py-2 text-sm font-medium rounded-md transition cursor-pointer"
					>Self</button>
				</div>

				<!-- Online tab -->
				<div data-show="$activeTab === 'online'">
					if existingGameID != "" {
						<!-- Already in game block -->
						<div class="bg-surface-1 border border-edge rounded-md p-4 flex flex-col gap-4">
							<div class="flex items-start gap-3">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-primary mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="12" cy="12" r="10"></circle>
									<line x1="12" y1="8" x2="12" y2="12"></line>
									<line x1="12" y1="16" x2="12.01" y2="16"></line>
								</svg>
								<div>
									<p class="text-sm font-semibold text-ink">You have an ongoing game</p>
									<p class="text-xs text-ink-subtle mt-0.5">Playing as { existingGameRole }</p>
								</div>
							</div>
							<div class="flex gap-3">
								<a
									href={ templ.SafeURL("/play/" + existingGameID) }
									class="flex-1 text-center py-2 text-sm font-medium bg-primary text-on-primary rounded-md hover:bg-primary-hover transition"
								>Rejoin game</a>
								<form method="POST" action={ templ.SafeURL("/play/" + existingGameID + "/abandon") }>
									<input type="hidden" name="_csrf" value={ csrfToken }/>
									<button
										type="submit"
										class="py-2 px-4 text-sm font-medium text-error border border-error rounded-md hover:bg-error-subtle transition"
									>Abandon &amp; start new</button>
								</form>
							</div>
						</div>
					} else {
						<!-- Online game creation -->
						if len(modes) == 0 {
							<p class="text-sm text-ink-subtle">No game modes available.</p>
						} else {
							<div class="grid gap-4">
								for i, mode := range modes {
									<form method="POST" action="/play">
										<input type="hidden" name="_csrf" value={ csrfToken }/>
										<input type="hidden" name="mode" value={ mode.Name }/>
										<button
											data-testid={ fmt.Sprintf("play-mode-button-%d", i) }
											type="submit"
											data-on:click={ templ.JSExpression(fmt.Sprintf("$loadingMode = %d", i)) }
											data-attr:disabled={ templ.JSExpression(fmt.Sprintf("$loadingMode !== -1 && $loadingMode !== %d", i)) }
											data-class={ templ.JSExpression(fmt.Sprintf(`
												(() => {
													const active = $loadingMode === %d;
													const blocked = $loadingMode !== -1 && $loadingMode !== %d;
													return {
														'opacity-50 cursor-not-allowed pointer-events-none': blocked,
														'bg-primary-subtle border-primary cursor-wait': active,
														'hover:bg-primary-subtle hover:shadow-md cursor-pointer': !active && !blocked,
													};
												})()
											`, i, i)) }
											class="w-full bg-surface-1 rounded-md shadow-sm border border-edge p-4 text-left transition"
										>
											<div class="flex justify-between items-center gap-3">
												<div class="min-w-0">
													<div class="text-lg font-semibold text-ink truncate">{ mode.Name }</div>
													<div class="text-sm text-ink-subtle">{ mode.Variant }</div>
												</div>
												<div class="text-sm text-ink-muted whitespace-nowrap shrink-0">
													{ helpers.FormatTime(mode.TimeNs) } + { helpers.FormatInc(mode.Increment) }
												</div>
											</div>
										</button>
									</form>
								}
							</div>
						}
					}
				</div>

				<!-- Computer tab -->
				<div data-show="$activeTab === 'computer'" style="display:none">
					if len(modes) == 0 {
						<p class="text-sm text-ink-subtle">No game modes available.</p>
					} else {
						<div class="grid gap-4">
							for i, mode := range modes {
								<form method="POST" action="/solo">
									<input type="hidden" name="_csrf" value={ csrfToken }/>
									<input type="hidden" name="mode" value={ mode.Name }/>
									<button
										data-testid={ fmt.Sprintf("game-mode-button-%d", i) }
										type="submit"
										data-on:click={ templ.JSExpression(fmt.Sprintf("$loadingMode = %d", i)) }
										data-attr:disabled={ templ.JSExpression(fmt.Sprintf("$loadingMode !== -1 && $loadingMode !== %d", i)) }
										data-class={ templ.JSExpression(fmt.Sprintf(`
											(() => {
												const active = $loadingMode === %d;
												const blocked = $loadingMode !== -1 && $loadingMode !== %d;
												return {
													'opacity-50 cursor-not-allowed pointer-events-none': blocked,
													'bg-primary-subtle border-primary cursor-wait': active,
													'hover:bg-primary-subtle hover:shadow-md cursor-pointer': !active && !blocked,
												};
											})()
										`, i, i)) }
										class="w-full bg-surface-1 rounded-md shadow-sm border border-edge p-4 text-left transition"
									>
										<div class="flex justify-between items-center gap-3">
											<div class="min-w-0">
												<div class="text-lg font-semibold text-ink truncate">{ mode.Name }</div>
												<div class="text-sm text-ink-subtle">{ mode.Variant }</div>
											</div>
											<div class="text-sm text-ink-muted whitespace-nowrap shrink-0">
												{ helpers.FormatTime(mode.TimeNs) } + { helpers.FormatInc(mode.Increment) }
											</div>
										</div>
									</button>
								</form>
							}
						</div>
					}
				</div>

				<!-- Self tab -->
				<div data-show="$activeTab === 'self'" style="display:none">
					<div class="flex flex-col items-center gap-4 py-16 text-center">
						<p class="font-semibold text-ink text-lg">Coming soon</p>
						<p class="text-ink-subtle text-sm">Self-play mode is under development.</p>
					</div>
				</div>
			</div>
		</div>
	}
}
