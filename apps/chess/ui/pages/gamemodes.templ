package pages

import "github.com/lordsonvimal/synergy/apps/chess/game"
import "github.com/lordsonvimal/synergy/apps/chess/ui/helpers"
import "github.com/lordsonvimal/synergy/apps/chess/ui/layouts"

templ GameModesPage(modes []game.GameMode) {
	@layouts.Layout("ChessLeap — Game Modes", false) {
		<div class="flex items-center justify-center min-h-full">
			<div class="w-full max-w-2xl px-4 py-6 sm:px-6">
				<h1 class="text-2xl font-bold text-ink mb-6">
					Choose a Game Mode
				</h1>
				<div class="grid gap-4">
					for _, mode := range modes {
						<form method="POST" action="/game">
							<input type="hidden" name="mode" value={ mode.Name }/>
							<button
								type="submit"
								class="w-full bg-surface rounded-md shadow-sm border border-edge p-4 text-left
								   hover:bg-primary-subtle hover:shadow-md transition cursor-pointer"
							>
								<div class="flex justify-between items-center">
									<div>
										<div class="text-lg font-semibold text-ink">
											{ mode.Name }
										</div>
										<div class="text-sm text-ink-secondary">
											{ mode.Variant }
										</div>
									</div>
									<div class="text-sm text-ink-dim">
										{ helpers.FormatTime(mode.TimeNs) } + { helpers.FormatInc(mode.Increment) }
									</div>
								</div>
							</button>
						</form>
					}
				</div>
			</div>
		</div>
	}
}
