package pages

import "github.com/lordsonvimal/synergy/apps/chess/game"
import "github.com/lordsonvimal/synergy/apps/chess/ui/components"
import "github.com/lordsonvimal/synergy/apps/chess/ui/layouts"
import "github.com/lordsonvimal/synergy/apps/chess/ui/ui_store"

templ NewGamePage(g *game.Game) {
	@layouts.Layout("ChessLeap", true) {
		<script type="module" src="/assets/datastar.js"></script>
		<script type="module" src="/assets/js/initClock.js"></script>
		<div
			class="flex flex-col items-center justify-center min-h-full p-4 gap-3"
			data-signals={ templ.JSONString(ui_store.ChessBoardSignalsFromGame(g)) }
		>
			@components.GameStatusBanner()

			<div class="w-[min(100%,calc(100vh-16rem),540px)] flex flex-col rounded-sm overflow-hidden shadow-2xl">
				<!-- Player cards + board: order-first/order-last from flip only affects this group -->
				<div class="flex flex-col">
					@components.BlackPlayerCard()
					<section class="relative w-full">
						@components.RenderChessBoard(g)
						@components.RenderPromotionOverlay(g)
					</section>
					@components.WhitePlayerCard()
				</div>
				<!-- Static nav bar: rendered once, never re-morphed by DataStar -->
				@components.NotationNavBar()
				<!-- Hidden data store: DataStar morphs this after each move -->
				@components.MoveNotationPanel(g.History)
			</div>

			<!-- Tools panel: detached card below the board zone -->
			<div class="w-[min(100%,calc(100vh-16rem),540px)] rounded-sm overflow-hidden shadow-sm">
				@components.GameToolsPanel()
			</div>
		</div>
	}
}
