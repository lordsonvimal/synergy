package pages

import (
	"github.com/lordsonvimal/synergy/apps/chess/game"
	"github.com/lordsonvimal/synergy/apps/chess/ui/components"
	"github.com/lordsonvimal/synergy/apps/chess/ui/helpers"
	"github.com/lordsonvimal/synergy/apps/chess/ui/layouts"
	"github.com/lordsonvimal/synergy/apps/chess/ui/ui_store"
)

templ PlayGamePage(g *game.Game, role string, flipped bool, csrfToken string) {
	@layouts.Layout("ChessLeap — Play", true) {
		<!-- datastar runtime is loaded once in layouts.Layout via the importmap -->
		<script type="module" src={ helpers.Asset("js/initClock.js") }></script>
		<script type="module" src={ helpers.Asset("js/board.js") }></script>
		<!-- data-init fires when DataStar mounts this element, opening a persistent
		     @get to /events so board patches from hubBroadcastBoard are received. -->
		<div class="hidden" data-init={ "@get('/play/" + g.ID + "/events')" }></div>
		<div
			class="flex flex-col items-center justify-start min-h-full sm:p-4 sm:gap-3"
			data-signals={ templ.JSONString(playPageSignals(g, role, flipped)) }
		>
			@components.GameStatusBanner()

			<!-- Toast layer (z=7 per CLAUDE.md). The only toast on this page today
			     is the reconnecting one; future ambient notifications add siblings. -->
			@components.ToastContainer() {
				@components.Toast(components.ToastWarning, "$connectionDown", "reconnecting-toast") {
					<span>
						Reconnecting&hellip;
						<span data-show="$timed"> your clock is paused.</span>
					</span>
				}
			}

			<div class="w-full sm:w-[min(100%,calc(100vh-16rem),540px)] flex flex-col border-y sm:border border-edge sm:rounded-sm overflow-hidden sm:shadow-2xl">
				@components.GameStatusRibbon(g)
				<div class="flex flex-col">
					@components.BlackPlayerCard()
					<section class="relative w-full">
						@components.RenderChessBoard(g, "/play")
						@components.RenderPromotionOverlay(g, "/play")
						<div
							class="absolute inset-0 z-10"
							data-show="$viewingHistory"
							data-signals.ifmissing='{"historyIdx": -1, "viewingHistory": false}'
							style="display:none"
						>
							<div id="history-board-content" class="w-full h-full"></div>
						</div>
					</section>
					@components.WhitePlayerCard()
				</div>
				@components.MoveNotationPanel("/play", g.ID, g.History)
				@components.GameToolsPanel(g.ID, role, csrfToken)
			</div>

			<!-- Share-links modal: shown until the opponent claims their seat. -->
			if (role == "white" || role == "black") && (!g.PlayMeta.WhiteClaimed || !g.PlayMeta.BlackClaimed) {
				@components.Modal("!$clockUnlocked", "", "Invite opponent", "share-links-modal") {
					@components.ShareLinksPanel(g.ID, g.PlayMeta.WhiteToken, g.PlayMeta.BlackToken, role)
				}
			}

			<!-- Rematch pending modal: shown to the player who proposed a rematch. -->
			@components.Modal("$rematchPending", "", "Rematch requested", "rematch-pending-modal") {
				@components.RematchPending(g.ID, csrfToken)
			}

			<!-- Rematch prompt modal: shown to the player receiving a rematch proposal. -->
			@components.Modal("$rematchProposed", "", "Rematch proposed", "rematch-prompt-modal") {
				@components.RematchPrompt(g.ID, csrfToken)
			}

			<!-- Resign confirm modal (local-only signal). -->
			@components.Modal("$resignConfirm", "$resignConfirm = false", "Confirm resign", "resign-confirm-modal") {
				@components.ResignConfirm(g.ID, csrfToken)
			}

			<!-- Draw offer modals. The JS effect ensures these signals are only
			     set while the game is ongoing (auto-cleared on next move / game end). -->
			@components.Modal("$drawOffered", "", "Draw offered", "draw-prompt-modal") {
				@components.DrawPrompt(g.ID, csrfToken)
			}
			@components.Modal("$drawPending", "", "Draw offer pending", "draw-pending-modal") {
				@components.DrawPending(g.ID, csrfToken)
			}

			<!-- Takeback modals. -->
			@components.Modal("$takebackOffered", "", "Takeback requested", "takeback-prompt-modal") {
				@components.TakebackPrompt(g.ID, csrfToken)
			}
			@components.Modal("$takebackPending", "", "Takeback pending", "takeback-pending-modal") {
				@components.TakebackPending(g.ID, csrfToken)
			}
		</div>
	}
}

type playSignals struct {
	SelectedSquare int    `json:"selectedSquare"`
	SideToMove     int    `json:"sideToMove"`
	PossibleMoves  []int  `json:"possibleMoves"`
	Promotion      bool   `json:"promotion"`
	PromotedSquare int    `json:"promotedSquare"`
	PromotionPiece int    `json:"promotionPiece"`
	GameState      int    `json:"gameState"`
	GameStateText  string `json:"gameStateText"`
	IsCheck        bool   `json:"isCheck"`
	Winner         int    `json:"winner"`
	Flipped        bool   `json:"flipped"`
	Role           string `json:"role"`
	WhiteOnline    bool   `json:"whiteOnline"`
	BlackOnline    bool   `json:"blackOnline"`
	ClockUnlocked  bool   `json:"clockUnlocked"`
	Timed          bool   `json:"timed"`
	FirstMoveDeadlineNs int64 `json:"firstMoveDeadlineNs"`
	FirstMoveSecondsLeft int  `json:"firstMoveSecondsLeft"`
	ClaimVictory       bool   `json:"claimVictory"`
	RematchProposed    bool   `json:"rematchProposed"`
	RematchPending     bool   `json:"rematchPending"`
	RematchSecondsLeft int    `json:"rematchSecondsLeft"`
	DrawOffered        bool   `json:"drawOffered"`
	DrawPending        bool   `json:"drawPending"`
	DrawSecondsLeft    int    `json:"drawSecondsLeft"`
	TakebackOffered    bool   `json:"takebackOffered"`
	TakebackPending    bool   `json:"takebackPending"`
	TakebackSecondsLeft int   `json:"takebackSecondsLeft"`
	ResignConfirm      bool   `json:"resignConfirm"`
	Fen                string `json:"fen"` // authoritative FEN; board.js re-anchors chessops on change
	ConnectionDown     bool   `json:"connectionDown"`
}

func firstMoveDeadlineNsFor(g *game.Game) int64 {
	if g.PlayMeta == nil {
		return 0
	}
	if !g.IsOngoing() || g.HistoryLen() > 0 {
		return 0
	}
	return g.PlayMeta.GetFirstMoveDeadlineNs()
}

func playPageSignals(g *game.Game, role string, flipped bool) *playSignals {
	base := ui_store.ChessBoardSignalsFromGame(g)
	// Don't leak the opponent's selection/highlights to the player whose turn it
	// isn't. Selection state is per-mover and meaningless (and confusing) to the
	// other side.
	if !ui_store.RoleMatchesSide(role, base.SideToMove) {
		base.ClearSelection()
	}
	return &playSignals{
		SelectedSquare:  int(base.SelectedSquare),
		SideToMove:      int(base.SideToMove),
		PossibleMoves:   base.PossibleMoves,
		Promotion:       base.Promotion,
		PromotedSquare:  int(base.PromotedSquare),
		PromotionPiece:  int(base.PromotionPiece),
		GameState:       int(base.GameState),
		GameStateText:   base.GameStateText,
		IsCheck:         base.IsCheck,
		Winner:          int(base.Winner),
		Flipped:         flipped,
		Role:            role,
		WhiteOnline:     false,
		BlackOnline:     false,
		ClockUnlocked:   g.PlayMeta != nil && g.PlayMeta.IsStarted(),
		Timed:           base.Timed,
		FirstMoveDeadlineNs: firstMoveDeadlineNsFor(g),
		FirstMoveSecondsLeft: 0,
		ClaimVictory:       false,
		RematchProposed:    false,
		RematchPending:     false,
		RematchSecondsLeft: 0,
		DrawOffered:        false,
		DrawPending:        false,
		DrawSecondsLeft:    0,
		TakebackOffered:    false,
		TakebackPending:    false,
		TakebackSecondsLeft: 0,
		ResignConfirm:      false,
		Fen:                base.Fen,
		ConnectionDown:     false,
	}
}
